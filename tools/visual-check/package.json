    "@playwright/test": "1.63.0",
    "pixelmatch": "7.2.0",
    "pngjs": "7.0.0"
  },
  "devDependencies": {
    "@komtru/config": "workspace:*",
    "@types/node": "22.20.5",
    "@types/pngjs": "6.0.5",
    "eslint": "9.39.5",
