{
  "$schema": "https://turbo.build/schema.json",
  "agentGuidance": false,
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": [
        "KOMTRU_INFRA_TESTS",
        "KOMTRU_TEST_DIRECT_URL",
        "KOMTRU_TEST_POOLED_URL",
        "KOMTRU_BROWSER_TESTS"
      ],
      "outputs": []
    }
  }
}
