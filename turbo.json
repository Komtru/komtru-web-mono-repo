{
  "$schema": "https://turbo.build/schema.json",
  "agentGuidance": false,
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "env": [
        "NEXT_PUBLIC_KOMTRU_APP_URL",
        "NEXT_PUBLIC_KOMTRU_API_URL",
        "NEXT_PUBLIC_KOMTRU_SOCKET_URL",
        "NEXT_PUBLIC_KOMTRU_PASSPORT_URL",
        "NEXT_PUBLIC_KOMTRU_PARK_URL",
        "NEXT_PUBLIC_SENTRY_DSN",
        "KOMTRU_SESSION_SECRET"
      ]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": [
        "KOMTRU_INFRA_TESTS",
        "KOMTRU_TEST_DIRECT_URL",
        "KOMTRU_TEST_POOLED_URL",
        "KOMTRU_BROWSER_TESTS"
      ],
      "outputs": []
    }
  }
}
