{
  "name": "@komtru/shared-types",
  "version": "0.0.0",
  "private": true,
  "description": "zod schemas, DTOs and enums shared by backend and frontends.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
