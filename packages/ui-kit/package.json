{
  "name": "@komtru/ui-kit",
  "version": "0.0.0",
  "private": true,
  "description": "Design tokens, brand mark and components from the HTML reference.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./fonts": {
      "types": "./dist/fonts.d.ts",
      "default": "./dist/fonts.js"
    },
    "./tokens.css": "./src/tokens.css",
    "./extract-tokens": "./scripts/extract-tokens.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build-storybook": "storybook build",
    "lint": "eslint .",
    "storybook": "storybook dev -p 6006 --no-open",
    "test": "vitest run",
    "tokens": "node --experimental-strip-types scripts/extract-tokens.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "devDependencies": {
    "@komtru/config": "workspace:*",
    "@storybook/addon-docs": "10.6.1",
    "@storybook/react-vite": "10.6.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.14.0",
    "eslint": "9.39.5",
    "jsdom": "29.1.1",
    "next": "15.5.27",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "storybook": "10.6.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
