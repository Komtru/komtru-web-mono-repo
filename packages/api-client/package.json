{
  "name": "@komtru/api-client",
  "version": "0.0.0",
  "private": true,
  "description": "Typed API client with auth refresh, idempotency and retry.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@komtru/shared-types": "workspace:*",
    "uuid": "14.0.2",
    "zod": "4.6.5"
  },
  "peerDependencies": {
    "@tanstack/react-query": "5.104.1",
    "react": "19.3.0",
    "socket.io-client": "4.8.4"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-query": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "socket.io-client": {
      "optional": true
    }
  },
  "devDependencies": {
    "@komtru/config": "workspace:*",
    "@tanstack/react-query": "5.104.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "fake-indexeddb": "6.2.5",
    "jsdom": "29.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "socket.io-client": "4.8.4",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
