{
  "name": "@komtru/config",
  "version": "0.0.0",
  "private": true,
  "description": "Shared TypeScript, ESLint, Prettier and Vitest presets for every Komtru workspace.",
  "type": "module",
  "exports": {
    "./tsconfig/*": "./tsconfig/*",
    "./eslint": "./eslint/index.mjs",
    "./prettier": "./prettier/index.json",
    "./vitest": "./vitest/preset.mjs",
    "./tailwind/preset.css": "./tailwind/preset.css"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  }
}
