# The public marketing site. Nothing here is a secret: every value is a NEXT_PUBLIC_* one that Next
# inlines into the browser bundle, and the site holds no session and calls no authenticated route.

# Where the consumer app lives. Every "Log in" and "Start a trade" button on the site points here,
# so this is the one value that decides whether the site's calls to action work at all.
NEXT_PUBLIC_KOMTRU_APP_URL=http://localhost:3001

# The backend, for the one call this site makes: the waitlist signup. Empty disables the network
# call and the form reports that signups are not open yet, rather than failing silently.
NEXT_PUBLIC_KOMTRU_API_URL=http://localhost:7813/v1

# This site's own origin, used for canonical URLs and the QR code that points at /waitlist.
NEXT_PUBLIC_KOMTRU_SITE_URL=http://localhost:3005
