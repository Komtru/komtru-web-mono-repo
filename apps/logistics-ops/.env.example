# Courier company portal (logistics.komtru.com). Copy to .env.local for local development.
NEXT_PUBLIC_KOMTRU_API_URL=http://localhost:7813/v1     # backend API base
NEXT_PUBLIC_KOMTRU_APP_URL=http://localhost:3003        # this app's own origin
NEXT_PUBLIC_KOMTRU_PARK_URL=http://localhost:3004       # Park Agents who log in here are sent there
NEXT_PUBLIC_KOMTRU_SOCKET_URL=http://localhost:7813     # realtime server
NEXT_PUBLIC_SENTRY_DSN=                                 # empty disables Sentry
