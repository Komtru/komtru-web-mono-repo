# Consumer app (app.komtru.com). Copy to .env.local for local development.
NEXT_PUBLIC_KOMTRU_API_URL=http://localhost:7813/v1     # backend API base
NEXT_PUBLIC_KOMTRU_APP_URL=http://localhost:3001        # this app's own origin
NEXT_PUBLIC_KOMTRU_PASSPORT_URL=http://localhost:3001/passport   # public Trust Passport pages
NEXT_PUBLIC_KOMTRU_PARK_URL=http://localhost:3004       # Park Agent app, linked from Account
NEXT_PUBLIC_KOMTRU_SOCKET_URL=http://localhost:7813     # realtime server
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=                        # Paystack Inline public key (test mode locally)
NEXT_PUBLIC_SENTRY_DSN=                                 # empty disables Sentry
