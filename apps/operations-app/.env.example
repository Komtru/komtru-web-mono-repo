# TrustOps console (ops.komtru.com). Copy to .env.local for local development.
NEXT_PUBLIC_KOMTRU_API_URL=http://localhost:7813/v1     # backend API base
NEXT_PUBLIC_KOMTRU_APP_URL=http://localhost:3002        # this app's own origin
NEXT_PUBLIC_KOMTRU_SOCKET_URL=http://localhost:7813     # realtime server
NEXT_PUBLIC_SENTRY_DSN=                                 # empty disables Sentry
KOMTRU_SESSION_SECRET=                                  # 32+ chars, server only; seals the session scope cookie middleware reads
