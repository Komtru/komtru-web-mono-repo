# Backend API environment. Generate the real file with `pnpm env:backend` (see docs/runbooks/local-dev.md);
# do not fill secrets in by hand. Variable names match the old backend so its .env drops in unchanged.

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development                  # development | test | production
PORT=7813                             # HTTP port for the API process
LOG_LEVEL=info                        # pino level
LOG_FORMAT=pretty                     # pretty locally, json in production
LOG_COLOR=true                        # colourise pretty logs
HTTP_LOG_ENABLED=true                 # request logging on/off
HTTP_LOG_ON_ARRIVAL=false             # also log when a request arrives, not only when it ends
HTTP_LOG_IGNORE_PATHS=/health/live,/health/ready   # comma-separated paths to skip
APP_WEB_BASE_URL=http://localhost:3001             # consumer app origin, for links in emails
APP_STAFF_WEB_BASE_URL=http://localhost:3002       # operations app origin
APP_MOBILE_LINK_SCHEME=komtru                      # deep-link scheme
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004
TRUST_PROXY_HOPS=0                    # load balancer hops in front of the API
RATE_LIMIT_WINDOW_MS=60000            # global per-IP limiter window
RATE_LIMIT_MAX=300                    # requests per window

# --- Postgres (through PgBouncer) and Redis --------------------------------
POSTGRES_URL=postgresql://komtru_app:komtru_app@localhost:56432/komtru_v2_dev   # runtime role, via PgBouncer
POSTGRES_DIRECT_URL=postgresql://komtru:komtru@localhost:55432/komtru_v2_dev   # owner; migrations only
POSTGRES_APP_PASSWORD=komtru_app      # the migrator sets this as komtru_app's password
POSTGRES_SSL=false
POSTGRES_POOL_MAX=10
POSTGRES_MIGRATE_ON_BOOT=false
REDIS_URL=redis://localhost:56379
# The namespace every Redis key lands under. Leave both unset in production and in normal
# development: they default to komtru: and komtru:bull. The integration suite sets them per Vitest
# worker so that test files running in parallel cannot see each other's queues, rate-limit counters
# or idempotency leases.
REDIS_KEY_PREFIX=
REDIS_QUEUE_PREFIX=
REDIS_ENABLED=true

# --- Observability ---------------------------------------------------------
SENTRY_DSN=                           # empty disables Sentry (design §12 Q8)
SENTRY_ENVIRONMENT=development

# --- Scheduler -------------------------------------------------------------
SCHEDULER_TIMEZONE=Africa/Lagos       # cron schedules run in this IANA timezone

# --- Crypto and tokens -----------------------------------------------------
ENCRYPTION_KEY=                       # 64 hex chars (AES-256-GCM); reuse the old backend's value
JWT_SECRET=
JWT_ACCESS_EXPIRATION_MINUTES=10
JWT_REFRESH_EXPIRATION_DAYS=30
IDENTITY_SIGNING_KEY=                 # Ed25519 seed, 64 hex chars; the public half is derived from it
IDENTITY_SIGNING_KEY_ID=              # the `kid` in every access token and in the JWKS
IDENTITY_HMAC_PEPPER=                 # >=32 chars; keys every OTP code and destination hash
IDENTITY_ACCESS_TOKEN_TTL_SECONDS=600
IDENTITY_TOKEN_ISSUER=https://api.komtru.com
IDENTITY_TOKEN_AUDIENCE=komtru
IDENTITY_BREACH_CHECK_ENABLED=false   # k-anonymity password check against the HIBP range API (S2)
IDENTITY_EPOCH_CACHE_TTL_SECONDS=10   # how long a user's sessions_epoch is cached in Redis (M1 D5)
IDENTITY_MIRROR_PHONE_OTP_TO_EMAIL=false  # local convenience: also email a phone OTP, never instead of the SMS
IDENTITY_SEED_ACCOUNT_MANAGERS=false

# The published version of each legal document (NDPA §15, screens TOS1/TOS2). Absent everywhere
# means the versions src/modules/identity/domain/terms.ts ships; set these when new copy goes live.
APP_TERMS_VERSION=2026-08-01
APP_PRIVACY_VERSION=2026-08-01

# --- Staff bootstrap -------------------------------------------------------
IDENTITY_BOOTSTRAP_ADMIN_EMAIL=
IDENTITY_BOOTSTRAP_ADMIN_NAME=
IDENTITY_BOOTSTRAP_ADMIN_ROLE=SUPER_ADMIN
IDENTITY_STAFF_ALLOW_PASSWORD_LOGIN=true
IDENTITY_STAFF_REQUIRE_MFA=true

# --- Social login and passkeys ---------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
APPLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_TEAM_ID=
APPLE_OAUTH_KEY_ID=
APPLE_OAUTH_PRIVATE_KEY=
FACEBOOK_OAUTH_CLIENT_ID=
FACEBOOK_OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_BASE_URL=http://localhost:3001
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Komtru
WEBAUTHN_ORIGINS=http://localhost:3001

# --- Notifications ---------------------------------------------------------
NOTIFY_DEFAULT_LOCALE=en-NG
NOTIFY_MAX_ATTEMPTS=5
NOTIFY_RETRY_BASE_DELAY_MS=2000
NOTIFY_RATE_LIMIT_WINDOW_MINUTES=60
NOTIFY_RATE_LIMIT_MAX_PER_WINDOW=20
NOTIFY_QUEUE_ENABLED=true
# Default true outside production. The message is rendered, recorded and logged with the recipient
# masked, but no provider is called: this, not a missing key, is what stops a local run texting a
# real person (T-003 keeps live provider credentials locally).
NOTIFY_SMS_DRY_RUN=true
NOTIFY_PUSH_DRY_RUN=true
MAILJET_API_KEY=
MAILJET_API_SECRET=
MAILJET_FROM_EMAIL=
MAILJET_FROM_NAME=Komtru
MAILJET_SANDBOX=true                  # keep true locally so no real email is sent
TERMII_API_KEY=
TERMII_SENDER_ID=
TERMII_BASE_URL=
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=

# --- Realtime --------------------------------------------------------------
SOCKET_PATH=/socket.io
SOCKET_CORS_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004
SOCKET_ENABLED=true                   # false builds no Socket.IO server at all
SOCKET_REVALIDATE_INTERVAL_SECONDS=30 # how often a live socket's session is re-checked
SOCKET_CREDENTIAL_GRACE_SECONDS=60    # how long a socket may hold a lapsed token before it is dropped

# --- File storage: five Cloudinary accounts (M20) --------------------------
CLOUDINARY_PROFILE_CLOUD_NAME=
CLOUDINARY_PROFILE_API_KEY=
CLOUDINARY_PROFILE_API_SECRET=
CLOUDINARY_CHAT_CLOUD_NAME=
CLOUDINARY_CHAT_API_KEY=
CLOUDINARY_CHAT_API_SECRET=
CLOUDINARY_TRADE_1_CLOUD_NAME=
CLOUDINARY_TRADE_1_API_KEY=
CLOUDINARY_TRADE_1_API_SECRET=
CLOUDINARY_TRADE_2_CLOUD_NAME=
CLOUDINARY_TRADE_2_API_KEY=
CLOUDINARY_TRADE_2_API_SECRET=
CLOUDINARY_TRADE_3_CLOUD_NAME=
CLOUDINARY_TRADE_3_API_KEY=
CLOUDINARY_TRADE_3_API_SECRET=
FILES_MAX_UPLOAD_BYTES=10485760       # checked at finalize; Cloudinary's upload API has no size gate
FILES_UPLOAD_TICKET_TTL_MINUTES=30    # an unused upload ticket is tombstoned after this
FILES_SIGNED_URL_TTL_SECONDS=300      # lifetime of a download URL for a non-public file
FILES_QUOTA_NEAR_PCT=85               # credits used at which an account is deprioritised in rotation
FILES_QUOTA_DISABLED_PCT=97           # credits used at which it leaves rotation entirely

# --- Payments --------------------------------------------------------------
PAYSTACK_SECRET_KEY=                  # test-mode key locally
PAYSTACK_PUBLIC_KEY=

# --- Trust and verification (M6) -------------------------------------------
# WHO ATTESTS AN IDENTITY. `FAKE` is a deterministic stub with no provider behind it: it passes,
# fails, stalls, errors or asks for review depending on the number's last digit, and every row it
# writes records provider=FAKE so a level it granted can be found later. A production process
# REFUSES TO BOOT on FAKE — name a real provider there.
TRUST_KYC_PROVIDER=FAKE
TRUST_REQUEST_TTL_MINUTES=1440        # an unanswered verification is expired by the sweep after this
# Dojah, the first real adapter (M6 §8). Selecting DOJAH without all three fails at boot naming them.
# No call has ever been made against a live Dojah account from this repository: the adapter is wired
# and refuses every call until that changes (owner's decision Q7).
DOJAH_APP_ID=
DOJAH_SECRET_KEY=
DOJAH_BASE_URL=
