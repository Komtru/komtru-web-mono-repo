{
  "name": "@komtru/backend-api",
  "version": "0.0.0",
  "private": true,
  "description": "Komtru backend: the HTTP API process and the background worker process.",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "dev:worker": "tsx watch --env-file-if-exists=.env src/worker.ts",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "start:worker": "node --env-file-if-exists=.env dist/worker.js",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:int": "KOMTRU_INFRA_TESTS=1 vitest run test/integration test/db",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate-cli.ts",
    "db:seed": "tsx --env-file-if-exists=.env src/db/seed-cli.ts"
  },
  "devDependencies": {
    "@komtru/config": "workspace:*",
    "@types/compression": "1.8.1",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/express-serve-static-core": "5.1.3",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "@komtru/shared-types": "workspace:*",
    "@sentry/node": "11.4.0",
    "bullmq": "6.3.11",
    "compression": "1.8.2",
    "cors": "2.8.6",
    "cron-parser": "5.10.1",
    "drizzle-orm": "0.45.3",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "ioredis": "5.11.1",
    "libphonenumber-js": "1.13.14",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "pino-pretty": "13.2.0",
    "rate-limiter-flexible": "11.2.1",
    "uuid": "14.0.2",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  }
}
