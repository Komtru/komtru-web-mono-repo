# Fake values shaped like the old backend's .env. Nothing here is a real credential.
NODE_ENV=development
PORT=3000
POSTGRES_URL=postgresql://fixture_user:fixture-db-password-123@devdb.fixture.us-east-1.rds.amazonaws.com:5432/komtru_dev
POSTGRES_SSL=true
REDIS_URL=redis://localhost:6379
ENCRYPTION_KEY=fixture0encryption0key0value0aaaabbbbccccdddd
MAILJET_API_KEY=fixture-mailjet-key-value
MAILJET_SANDBOX=false
GOOGLE_OAUTH_CLIENT_ID=first-google-client-id-value
PAYSTACK_SECRET_KEY="fixture-paystack-secret-value"
GOOGLE_OAUTH_CLIENT_ID=second-google-client-id-value
FCM_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"fixture-project"}'
APPLE_OAUTH_PRIVATE_KEY="line-one\nline-two"
HTTP_LOG_IGNORE_PATHS=/health,/metrics # trailing comment
# The old stack's own frontend topology: ports this monorepo does not use, and two empty
# base URLs. Copied verbatim, these mis-wire every local run.
APP_WEB_BASE_URL=
APP_STAFF_WEB_BASE_URL=
OAUTH_REDIRECT_BASE_URL=http://localhost:3000
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGINS=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:7820,http://localhost:5501
SOCKET_CORS_ORIGINS=http://localhost:3000,http://localhost:7820,http://localhost:5501
