{
  "name": "komtru",
  "private": true,
  "description": "Komtru monorepo: backend API, four frontends and shared packages.",
  "type": "module",
  "packageManager": "pnpm@10.18.2",
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test && pnpm test:repo",
    "test:repo": "vitest run --config scripts/vitest.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,mts,mjs}": "prettier --write",
    "*.{json,md,yml,yaml,css}": "prettier --write"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@commitlint/lint": "21.2.3",
    "@commitlint/load": "21.2.3",
    "@komtru/config": "workspace:*",
    "@types/node": "22.20.5",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "prettier": "3.9.9",
    "turbo": "2.11.7",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
