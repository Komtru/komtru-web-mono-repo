{
  "name": "komtru",
  "private": true,
  "description": "Komtru monorepo: backend API, four frontends and shared packages.",
  "packageManager": "pnpm@10.18.2",
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@komtru/config": "workspace:*",
    "prettier": "3.9.9",
    "turbo": "2.11.7",
    "typescript": "6.0.3"
  }
}
