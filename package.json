{
  "name": "komtru",
  "private": true,
  "description": "Komtru monorepo: backend API, four frontends and shared packages.",
  "type": "module",
  "packageManager": "pnpm@10.18.2",
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test && pnpm test:repo",
    "test:repo": "vitest run --config scripts/vitest.config.ts",
    "test:infra": "KOMTRU_INFRA_TESTS=1 vitest run --config scripts/vitest.config.ts test/local-infra.test.ts",
    "env:backend": "node scripts/env/populate-backend-env.mjs",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "infra:reset": "docker compose down --volumes",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*": "secretlint --secretlintignore .secretlintignore",
    "*.{ts,tsx,mts,mjs}": "prettier --write",
    "*.{json,md,yml,yaml,css}": "prettier --write"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@commitlint/lint": "21.2.3",
    "@commitlint/load": "21.2.3",
    "@komtru/config": "workspace:*",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.7",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "husky": "9.1.7",
    "ioredis": "5.11.1",
    "lint-staged": "16.4.0",
    "pg": "8.23.1",
    "prettier": "3.9.9",
    "secretlint": "13.0.7",
    "turbo": "2.11.7",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
